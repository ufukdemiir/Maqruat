---
import { getEntry } from "astro:content";
import { withBase } from "../lib/url";
import { getMaqruatLinks, getPersonalLinks } from "../lib/social";
import { getVerificationTags } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article" | "profile";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Kök-göreli görsel yolu (ör. "/og-image.png"). Belirtilmezse sitenin
   * varsayılan paylaşım görseli kullanılır — bkz. public/og-image.png.
   * İleride bir sayfaya özel paylaşım görseli eklemek istenirse, bu prop'a
   * değer geçmek yeterlidir; ayrıca kod değişikliği gerekmez.
   */
  image?: string;
}

const { title, description, ogType = "website", structuredData, image = "/og-image.png" } = Astro.props;

const settings = await getEntry("settings", "main");
const readerName = settings?.data.readerName || "Ufuk Demir";
const metaDescription =
  description || settings?.data.siteDescription || "Ufuk Demir'in kişisel okuma takibi ve kütüphanesi.";

const siteName = "Maqruat";
const fullTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(withBase(image), Astro.site);

// Arama motorlarına, bu sitenin ve sahibinin resmî hesaplarını bildiren
// schema.org `sameAs` listeleri (bkz. src/lib/social.ts). Yalnızca herkese
// açık profil sayfaları dahil edilir; boş bağlantılar zaten üretilmez.
// Sitenin GERÇEK kök adresi alt yolu da içerir (https://.../Maqruat/);
// `Astro.site` tek başına yalnızca alan adını verdiği için `withBase` ile
// birleştiriliyor.
const siteUrl = new URL(withBase("/"), Astro.site).toString();
const logoURL = new URL(withBase("/logo.png"), Astro.site).toString();
const maqruatLinks = getMaqruatLinks(settings?.data.maqruatSocial);
const maqruatSameAs = maqruatLinks.filter((link) => link.sameAs).map((link) => link.href);
const contactEmail = maqruatLinks.find((link) => link.key === "email")?.href.replace(/^mailto:/i, "");
const personalSameAs = getPersonalLinks(settings?.data.social)
  .filter((link) => link.sameAs)
  .map((link) => link.href);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}#person`,
  name: readerName,
  url: siteUrl,
  description: settings?.data.tagline || metaDescription,
  ...(personalSameAs.length > 0 && { sameAs: personalSameAs }),
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}#organization`,
  name: siteName,
  url: siteUrl,
  logo: logoURL,
  founder: { "@id": `${siteUrl}#person` },
  ...(contactEmail && {
    email: contactEmail,
    contactPoint: { "@type": "ContactPoint", email: contactEmail, contactType: "general inquiries", availableLanguage: "tr" },
  }),
  ...(maqruatSameAs.length > 0 && { sameAs: maqruatSameAs }),
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}#website`,
  name: siteName,
  url: siteUrl,
  description: settings?.data.siteDescription || metaDescription,
  author: { "@id": `${siteUrl}#person` },
  publisher: { "@id": `${siteUrl}#organization` },
  inLanguage: "tr-TR",
};

// Site sahipliği doğrulama etiketleri (Pinterest, Google Search Console, ...).
// Kodlar CMS'ten girilir: Genel Ayarlar → Site Sahipliği Doğrulama.
const verificationTags = getVerificationTags(settings?.data.verification);

const extraSchemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
{/* Favicon: Google Arama, sonuçlarda göstereceği site simgesi için SVG'yi
     DESTEKLEMEZ (yalnızca PNG/ICO/GIF/BMP/statik WebP kabul eder ve karenin
     48'in katı bir boyutta olmasını ister) — bu yüzden asıl kaynak (PNG),
     modern tarayıcılar için de SVG birlikte tanımlanıyor. sizes="any" olan
     SVG, onu destekleyen tarayıcılarda PNG'nin önüne geçer; PNG ise hem
     eski tarayıcılar hem de Google'ın kendisi için birincil kaynaktır. */}
<link rel="icon" type="image/png" sizes="96x96" href={withBase("/favicon-96.png")} />
<link rel="icon" type="image/png" sizes="48x48" href={withBase("/favicon-48.png")} />
<link rel="icon" type="image/svg+xml" sizes="any" href={withBase("/favicon.svg")} />
<link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
<link rel="sitemap" href={withBase("/sitemap-index.xml")} />
<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
<meta name="author" content={readerName} />

{/* Site sahipliği doğrulamaları (yalnızca doldurulmuş olanlar yazılır) */}
{verificationTags.map((tag) => <meta name={tag.name} content={tag.content} />)}

{/* Open Graph / Facebook */}
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="tr_TR" />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${siteName} — ${readerName}`} />

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={`${siteName} — ${readerName}`} />

{/* RSS akışının otomatik keşfi: okuyucu uygulamaları ve tarayıcı eklentileri
    akışı, sitenin herhangi bir sayfasından bulabilir. */}
<link
  rel="alternate"
  type="application/rss+xml"
  title="Maqruat — RSS akışı"
  href={new URL(withBase("/rss.xml"), Astro.site).toString()}
/>

{/* Fontlar kendi sitemizden sunulur (@font-face tanımları: src/styles/global.css).
    Her sayfada kullanılan dosyalar önceden yüklenir: böylece metin, yedek
    fontla çizilip sonradan "zıplamaz". Tüm font dosyaları aynı kökenden olsa
    da, tarayıcı gereği font ön yüklemeleri `crossorigin` ister. */}
{
  [
    "maqruat-serif-latin-roman.woff2",
    "maqruat-serif-latin-ext-roman.woff2",
    "maqruat-serif-latin-italic.woff2",
    "plus-jakarta-sans-latin.woff2",
    "plus-jakarta-sans-latin-ext.woff2",
  ].map((file) => (
    <link rel="preload" href={withBase(`/fonts/${file}`)} as="font" type="font/woff2" crossorigin />
  ))
}

<script is:inline define:vars={{ storageKey: "maqruat-theme" }}>
  // Koyu/aydınlık mod tercihini sayfa boyanmadan ÖNCE uygula (FOUC engelleme).
  (function () {
    try {
      const stored = localStorage.getItem(storageKey);
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const isDark = stored ? stored === "dark" : prefersDark;
      document.documentElement.classList.toggle("dark", isDark);
    } catch (_) {
      /* localStorage erişilemezse aydınlık moda düşülür */
    }
  })();
</script>

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
{
  extraSchemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
