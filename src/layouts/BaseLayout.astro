---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchModal from "../components/SearchModal.astro";
import BackToTop from "../components/BackToTop.astro";
import InfoStrip from "../components/InfoStrip.astro";
import { withBase } from "../lib/url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article" | "profile";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Kök-göreli paylaşım (OG) görseli — bkz. BaseHead.astro. Verilmezse
   * sitenin varsayılan paylaşım görseli (public/og-image.png) kullanılır. */
  image?: string;
}

const { title, description, ogType, structuredData, image } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={title} description={description} ogType={ogType} structuredData={structuredData} image={image} />
  </head>
  <body class="flex min-h-screen flex-col">
    {/* Klavye ve ekran okuyucu kullanıcıları için: başlığı atlayıp doğrudan
        içeriğe geçer. Yalnızca odaklanınca görünür. */}
    <a
      href="#icerik"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-leather focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-paper focus:shadow-lg"
    >
      İçeriğe geç
    </a>
    <Header />
    <main id="icerik" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <aside aria-label="Arşiv bağlantısı">
      <InfoStrip>
        Kitapların, alıntıların, incelemelerin, notların ve blog yazılarının tamamını tek bir zaman akışında görmek için{" "}
        <a href={withBase("/arsiv/")} class="font-semibold text-leather hover:underline">arşive</a> göz atabilirsiniz.
      </InfoStrip>
    </aside>
    <Footer />
    <SearchModal />
    <BackToTop />
  </body>
</html>
